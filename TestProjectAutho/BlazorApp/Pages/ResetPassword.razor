@page "/reset-password"
@inject AuthService AuthService

<h3>Reset Password</h3>

<EditForm Model="model" OnValidSubmit="HandleReset">
    <InputText @bind-Value="model.Email" placeholder="Email" />
    <InputText @bind-Value="model.Token" placeholder="Token" />
    <InputText @bind-Value="model.NewPassword" placeholder="New Password" type="password" />
    <ValidationMessage For="@(() => model.Email)" />
    <ValidationMessage For="@(() => model.NewPassword)" />
    <button type="submit">Reset Password</button>
</EditForm>

@if (success)
{
    <p>Password reset successful!</p>
}

@code {
    private ResetPasswordModel model = new();
    private bool success = false;

    private async Task HandleReset()
    {
        success = await AuthService.ResetPassword(model);
    }
}
