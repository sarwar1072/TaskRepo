@page "/reset-password"
@inject IAuthService AuthService

<h3>Reset Password</h3>

<EditForm Model="model" OnValidSubmit="HandleReset">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" class="form-control" @bind-Value="model.Email" placeholder="Enter your email" />
        <ValidationMessage For="@(() => model.Email)" />
    </div>

    <div class="mb-3">
        <label for="token" class="form-label">Reset Token</label>
        <InputText id="token" class="form-control" @bind-Value="model.Token" placeholder="Enter reset token" />
    </div>

    <div class="mb-3">
        <label for="newPassword" class="form-label">New Password</label>
        <InputText id="newPassword" type="password" class="form-control" @bind-Value="model.NewPassword" placeholder="Enter new password" />
        <ValidationMessage For="@(() => model.NewPassword)" />
    </div>

    <button type="submit" class="btn btn-primary">Reset Password</button>
</EditForm>

@if (success)
{
    <div class="alert alert-success mt-3" role="alert">
        Password reset successful!
    </div>
}


@code {
    private ResetPasswordModel model = new();
    private bool success = false;

    private async Task HandleReset()
    {
        success = await AuthService.ResetPassword(model);
    }
}


