@page "/forgot-password"
@inject AuthService AuthService

<h3>Forgot Password</h3>

<EditForm Model="model" OnValidSubmit="HandleForgotPassword">
    <InputText @bind-Value="model.Email" placeholder="Email" />
    <ValidationMessage For="@(() => model.Email)" />
    <button type="submit">Send Reset Link</button>
</EditForm>

@if (!string.IsNullOrEmpty(resetToken))
{
    <p><b>Token (for testing):</b> @resetToken</p>
}

@code {
    private ForgotPasswordModel model = new();
    private string? resetToken;

    private async Task HandleForgotPassword()
    {
        resetToken = await AuthService.ForgotPassword(model);
    }
}
