@page "/forgot-password"
@inject IAuthService AuthService

<h3>Forgot Password</h3>

<EditForm Model="@forgotModel" OnValidSubmit="HandleForgotPassword">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText @bind-Value="forgotModel.Email" placeholder="Email" />
    <button type="submit">Submit</button>
</EditForm>

<p>@responseMessage</p>

@code {
    private ForgotPasswordModel forgotModel = new();
    private string? responseMessage;

    private async Task HandleForgotPassword()
    {
        var token = await AuthService.ForgotPassword(forgotModel);
        responseMessage = token != null ? $"Token: {token}" : "Something went wrong.";
    }
}
 