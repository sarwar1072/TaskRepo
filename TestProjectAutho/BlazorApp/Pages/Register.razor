@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Nav

<h3>Register</h3>


<EditForm Model="registerModel" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="fullName" class="form-label">Full Name</label>
        <InputText id="fullName" class="form-control" @bind-Value="registerModel.FullName" placeholder="Enter your full name" />
        <ValidationMessage For="@(() => registerModel.FullName)" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" class="form-control" @bind-Value="registerModel.EmailAddress" placeholder="Enter your email" />
        <ValidationMessage For="@(() => registerModel.EmailAddress)" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="registerModel.PassWord" placeholder="Enter a password" />
        <ValidationMessage For="@(() => registerModel.PassWord)" />
    </div>

    <button type="submit" class="btn btn-success">Register</button>
</EditForm>

@code {
    RegisterVM registerModel = new();
    LoginVM loginModel = new();

    async Task HandleRegister()
    {
        var result = await AuthService.Register(registerModel);

        if (!string.IsNullOrEmpty(result)) 
        {
            loginModel.EmailAddress = registerModel.EmailAddress;
            loginModel.PassWord = registerModel.PassWord;

            var loginResult = await AuthService.Login(loginModel);
            if (loginResult)
            {
                Nav.NavigateTo("/"); 
            }
        }
        else
        {
            Console.WriteLine("Registration failed");
        }
    }
}
