@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Nav

<h3>Register</h3>

<EditForm Model="registerModel" OnValidSubmit="HandleRegister">
    <InputText @bind-Value="registerModel.FullName" placeholder="Full Name" />
    <InputText @bind-Value="registerModel.EmailAddress" placeholder="Email" />
    <InputText @bind-Value="registerModel.PassWord" type="password" placeholder="Password" />
    <button type="submit">Register</button>
</EditForm>

@code {
    RegisterVM registerModel = new();
    LoginVM loginModel = new();

    async Task HandleRegister()
    {
        var result = await AuthService.Register(registerModel);

        if (!string.IsNullOrEmpty(result)) 
        {
            loginModel.EmailAddress = registerModel.EmailAddress;
            loginModel.PassWord = registerModel.PassWord;

            var loginResult = await AuthService.Login(loginModel);
            if (loginResult)
            {
                Nav.NavigateTo("/"); 
            }
        }
        else
        {
            Console.WriteLine("Registration failed");
        }
    }
}
